{
  "manifest_version": 3,
  "name": "Nexora Video Google Flow Helper",
  "version": "1.4.2",
  "description": "Tự động sinh ảnh/video trên Google Flow từ Nexora Video Studio.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "downloads",
    "sidePanel",
    "scripting",
    "debugger",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://flow.google.com/*",
    "https://labs.google/fx/*",
    "https://*.googleusercontent.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "Đẩy nhanh sang Google Flow"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-bridge.js"]
    },
    {
      "matches": [
        "*://flow.google.com/*",
        "*://labs.google/fx/*"
      ],
      "js": ["content-flow.js"]
    }
  ]
}
